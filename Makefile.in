BUILD_EPA_TOOLS=@PEBIL_BUILD_EPA_TOOLS@
PEBIL_TOOLS_PATH=@PEBIL_EPA_TOOLS_PATH@
CLEANS = clean-subdirs
DEPENDS = depend-subdirs

## change the following variables to fit your system:
DOXYGEN = doxygen

# order here matters
PREREQ = .CLEAN .DEPEND

SUBDIRS = external/udis86-1.7 external/epa-inst-libs/ReuseDistance external/epa-inst-libs src tools
ifeq ($(BUILD_EPA_TOOLS),yes)
    SUBDIRS += $(PEBIL_TOOLS_PATH)
    CLEANS += clean-pebil-tools
    PREREQ += pebil-tools-deps
endif

COPY_LIBS = cp external/epa-inst-libs/ReuseDistance/libReuseDistance.so lib

BLACKLIST = scripts/inputlist/autogen-system.func

include VERSION
DISTDIR = PEBIL-$(PEBIL_FULL_VER)

.PHONY: subdirs $(SUBDIRS) clean all install blacklist depend docs

# specify some explicit dependencies to order operations
tools: src external/udis86-1.7 external/epa-inst-libs/ReuseDistance
install: external/epa-inst-libs tools blacklist

ifneq (,$(findstring clean,$(MAKECMDGOALS)))
.CLEAN: clean
else
.CLEAN:
endif
ifneq (,$(findstring depend,$(MAKECMDGOALS)))
.DEPEND: depend
else
.DEPEND:
endif

clean-pebil-tools:
	$(MAKE) -C $(PEBIL_TOOLS_PATH) clean

clean-subdirs:
	$(MAKE) -C external/udis86-1.7 clean
	$(MAKE) -C external/epa-inst-libs/ReuseDistance clean
	$(MAKE) -C src clean
	$(MAKE) -C external/epa-inst-libs clean
	$(MAKE) -C tools clean

clean: $(CLEANS)
	rm -rf $(BLACKLIST)

depend-subdirs: .CLEAN
	$(MAKE) -C src depend
	$(MAKE) -C tools depend

depend: .CLEAN $(DEPENDS)

pebil-tools-deps:
	$(MAKE) -C $(PEBIL_TOOLS_PATH) pebil-deps

all: $(PREREQ) subdirs blacklist
subdirs: $(SUBDIRS)
	echo "************* SUBDIRS *****************"
	echo $(SUBDIRS)

$(SUBDIRS): $(PREREQ)
	$(MAKE) -C $@ 

install: $(PREREQ)
	$(MAKE) -C src install
	$(MAKE) -C tools install
	$(MAKE) -C external/epa-inst-libs install
	$(COPY_LIBS)

docs: $(PREREQ)
	doxygen

blacklist: $(PREREQ) $(BLACKLIST)
$(BLACKLIST): $(PREREQ)
	scripts/blacklist.sh > $(BLACKLIST)
