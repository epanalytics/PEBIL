setenv PEBIL_ROOT @abs_top_builddir@
echo "***** initializing environment using PEBIL_ROOT=$PEBIL_ROOT"
setenv LD_LIBRARY_PATH ${PEBIL_ROOT}/lib:${PEBIL_ROOT}/external/epa-inst-libs/ReuseDistance:${LD_LIBRARY_PATH}
setenv PATH ${PEBIL_ROOT}/bin:${PEBIL_ROOT}/scripts:${PEBIL_ROOT}/external/udis86-1.7/udcli:${PATH}

#### EPA-TOOLS
useEPATools="@PEBIL_EPA_TOOLS_AVAILABLE@"
epaToolsPath="@PEBIL_ENV_EPA_TOOLS_PATH@"

if (("${useEPATools}" == "yes") && ("${epaToolsPath}" != ""))
then
  setenv LD_LIBRARY_PATH "${epaToolsPath}/tools:${epaToolsPath}/external/epa-inst-libs:${LD_LIBRARY_PATH}"
fi

#### PAPI
usepapi="@PEBIL_PAPI_BUILD@"
pebilPapiPath="@PAPI_PATH@"

if (("${usepapi}" == "yes") && ("${pebilPapiPath}" != ""))
then
  setenv LD_LIBRARY_PATH "${pebilPapiPath}/lib:${LD_LIBRARY_PATH}"
fi

